# ─────────────────────────────────────────────────────────────────────────────
# Historical Coverage Explorer — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=historical_coverage
POSTGRES_USER=hce_user
POSTGRES_PASSWORD=changeme

# ─── Backend ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://hce_user:changeme@localhost:5432/historical_coverage
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
