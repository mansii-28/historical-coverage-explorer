# ─────────────────────────────────────────────────────────────────────────────
# Historical Coverage Explorer — Environment Variables Template
# Copy this file to .env and configure for your local environment:
#   cp .env.example .env
# NEVER commit your active .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL (Local Development Placeholders) ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=historical_coverage
POSTGRES_USER=hce_user
POSTGRES_PASSWORD=changeme

# ─── Backend ─────────────────────────────────────────────────────────────────
# Required: async PostgreSQL connection string using the psycopg driver.
DATABASE_URL=postgresql+psycopg://hce_user:changeme@localhost:5432/historical_coverage
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_API=false
