# ─────────────────────────────────────────────────────────────────────────────
# Historical Coverage Explorer — Environment Variables Template
# Copy this file to .env and configure for your local environment:
#   cp .env.example .env
# NEVER commit your active .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL (Local Development Placeholders) ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=historical_coverage
POSTGRES_USER=hce_user
POSTGRES_PASSWORD=changeme

# ─── Backend ─────────────────────────────────────────────────────────────────
# Runtime: Pooled connection string (Neon pooled endpoint / local PostgreSQL)
DATABASE_URL=postgresql+psycopg://hce_user:changeme@localhost:5432/historical_coverage
# Migrations: Direct unpooled connection string (Neon unpooled endpoint for DDL migrations)
DATABASE_URL_UNPOOLED=postgresql+psycopg://hce_user:changeme@localhost:5432/historical_coverage
ENVIRONMENT=development
DEMO_RESET_ENABLED=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ─── Frontend ────────────────────────────────────────────────────────────────
# Optional in production (defaults to same-origin relative URLs).
# In local development, proxies /api and /health to http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_API=false
